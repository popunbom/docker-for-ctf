#!/bin/bash

# REF: https://zap.hatenablog.jp/entry/2023/03/14/131844
# REF: https://trap.jp/post/2767/

if [[ $# -lt 2 ]]; then
  echo "Usage: $0 <init-script> [target] [args...]"
  exit 1
fi

init_script="$1"
shift

if [[ $# -eq 0 ]]; then
  echo "Usage: ${0##*/} <init-script> [target] [args...]"
  exit 1
fi

target="$1"
shift

function extract_target_arch() {
  if [[ ! -f "$target" ]]; then
    echo "Error: Target file '$target' does not exist." >&2
    exit 1
  fi
  file -b "$target" | awk -F, '{print tolower($2)}' | tr -d ' '
}

function exec_directly() {
  gdb -q \
    -iex "$init_script" \
    -iex "file ${target}" \

  gdb_status=$?
  exit "$gdb_status"
}

function exec_via_qemu() {
  qemu-x86_64-static -g 1234 "$target" "$@" < /dev/tty &
  pid=$!

  cleanup() {
    if kill -0 "$pid" 2>/dev/null; then
      kill "$pid" 2>/dev/null || true
      wait "$pid" 2>/dev/null || true
    fi
  }

  trap cleanup EXIT INT TERM HUP

  gdb -q \
    -iex "$init_script" \
    -iex "file ${target}" \
    -iex "target remote localhost:1234"

  gdb_status=$?
  exit "$gdb_status"
}

cpu_arch="$(uname -m)"
target_arch="$(extract_target_arch)"
if [[ "$cpu_arch" != "$target_arch" ]]; then
  echo "Launch gdb via QEMU: cpu_arch=$cpu_arch, target_arch=$target_arch" >&2
  exec_via_qemu
else
  echo "Launch gdb directly: cpu_arch=$cpu_arch, target_arch=$target_arch" >&2
  exec_directly
fi
